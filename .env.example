# Groq API Keys (Agents strictly use keys 8 to 14)
GROQ_API_KEY_8=gsk_your_groq_api_key_8_here
GROQ_API_KEY_9=gsk_your_groq_api_key_9_here
GROQ_API_KEY_10=gsk_your_groq_api_key_10_here
GROQ_API_KEY_11=gsk_your_groq_api_key_11_here
GROQ_API_KEY_12=gsk_your_groq_api_key_12_here
GROQ_API_KEY_13=gsk_your_groq_api_key_13_here
GROQ_API_KEY_14=gsk_your_groq_api_key_14_here

# Default fallback / primary key if needed
GROQ_API_KEY=gsk_your_groq_api_key_8_here

# LLM Model (Mandatory: Must strictly remain openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Arize Phoenix Tracing Configuration
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=agentic-workflow-optimizer
# PHOENIX_API_KEY=your_phoenix_api_key_if_using_cloud
